# Server (production) — Abasthan/Render injects PORT automatically
PORT=4000

# Optional tuning
RESERVED_ROOM_CODE=0000
MAX_ROOM_SIZE=50
MESSAGE_CAP=200

# Giphy API key for GIF/sticker search (server-side proxy at GET /api/giphy).
# Put it here (root .env) or in the host's settings — never in client/.env.
GIPHY_API_KEY=

# Cloudinary (optional) — hosts large media on a CDN so uploads never hit the
# host's request-body ceiling and stay out of the server's memory. When unset,
# the app falls back to in-memory media uploads. Cloudinary free = 25 credits/mo.
#   - cloud name, API key/secret, and an UNSIGNED upload preset (dashboard →
#     Settings → Upload → add unsigned preset; you may restrict to a folder).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional: allow another origin to connect (e.g. Vercel frontend)
CORS_ORIGIN=http://localhost:5173

# Admin console key (X-Admin-Key header, /admin). Generate with `openssl rand -hex 24`.
ADMIN_KEY=

# Redis (optional). Leave unset to run everything in process memory (single
# instance — the default and the fastest option). Set it to share sessions,
# rooms, messages, bans, settings and rate limits across multiple instances.
#   - REDIS_URL is preferred: redis://[:password@]host:6379/0  (rediss:// for TLS)
#   - Or use the discrete REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB.
#   - REDIS_PREFIX namespaces keys so one Redis can host several apps.
#   - REDIS_TLS=true forces TLS when using REDIS_HOST instead of a rediss:// URL.
REDIS_URL=
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# REDIS_PREFIX=cryo

# Frontend (only for split hosting: Vercel frontend -> Abasthan backend)
VITE_SERVER_URL=
